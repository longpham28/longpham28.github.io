---
import "../styles/global.css";
import { profile } from "../data/profile";
import { locales, languageNames, ogLocales, routes, ui, type Page } from "../lib/i18n";
import type { Locale } from "../lib/content";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  page?: Page;
}

const { locale, title, description, path, page } = Astro.props;
const origin = "https://longpham28.github.io";
const socialImage = new URL("/social-card.png", origin);
const labels = ui[locale];
const socialImageAlt = labels.social;
const home = routes.home[locale];
const publications = routes.publications[locale];
const equivalents = routes[page ?? "home"];
const fragments = page === "home" ? ["", "about", "research", "publications", "cv", "recognition"] : [""];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.japaneseName,
  jobTitle: profile.role.en,
  affiliation: { "@type": "Organization", name: "University of Tsukuba" },
  sameAs: profile.links.map((link) => link.href),
  url: origin,
};
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="ML4fEzbFCqbd-gFu_-Hs_1j2ee3PBmL8jnT-JR6DOnI" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, origin)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, origin)} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {page && locales.filter((lang) => lang !== locale).map((lang) => <meta property="og:locale:alternate" content={ogLocales[lang]} />)}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {page && <>
      {locales.map((lang) => <link rel="alternate" hreflang={lang} href={new URL(equivalents[lang], origin)} />)}
      <link rel="alternate" hreflang="x-default" href={new URL(equivalents.en, origin)} />
    </>}
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.remove("no-js");
        let saved = null;
        try { saved = localStorage.getItem("preferred-theme"); } catch {}
        if (saved === "light" || saved === "dark") root.dataset.theme = saved;
        const dark = saved === "dark" || (saved !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#151410" : "#ffffff");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={home} aria-label={`${profile.name} — ${labels.home}`}><span>{profile.name}</span></a>
        <nav class="main-navigation" aria-label={labels.navigation}>
          <a href={`${home}#about`}>{labels.about}</a>
          <a href={`${home}#research`}>{labels.research}</a>
          <a href={publications}>{labels.publications}</a>
          <a href={`${home}#cv`}>{labels.cv}</a>
        </nav>
        <div class="header-actions">
          <nav class="language-navigation" aria-label={labels.language}>
            {fragments.map((fragment) => <span class="language-group" data-fragment={fragment}>{locales.map((lang) => <a class="language-link" href={`${equivalents[lang]}${fragment ? `#${fragment}` : ""}`} lang={lang} hreflang={lang} aria-current={page && lang === locale ? "page" : undefined}>{languageNames[lang]}</a>)}</span>)}
          </nav>
          <details class="theme-picker">
            <summary aria-label={labels.appearance} title={labels.appearance}>
              <svg class="theme-icon" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="6.5"></circle>
                <path d="M10 3.5a6.5 6.5 0 0 1 0 13Z"></path>
              </svg>
              <span class="sr-only">{labels.appearance}</span>
            </summary>
            <div class="theme-menu">
              <button class="theme-option" type="button" data-theme-option="system" aria-pressed="true">{labels.system}</button>
              <button class="theme-option" type="button" data-theme-option="light" aria-pressed="false">{labels.light}</button>
              <button class="theme-option" type="button" data-theme-option="dark" aria-pressed="false">{labels.dark}</button>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p>{labels.footer}</p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const picker = document.querySelector(".theme-picker");
        const pickerSummary = picker?.querySelector("summary");
        const options = [...document.querySelectorAll("[data-theme-option]")];
        const media = matchMedia("(prefers-color-scheme: dark)");
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (!picker || !options.length) return;

        const readTheme = () => {
          try {
            const saved = localStorage.getItem("preferred-theme");
            return saved === "light" || saved === "dark" ? saved : "system";
          } catch { return "system"; }
        };
        const updateThemeColor = (theme) => {
          const dark = theme === "dark" || (theme === "system" && media.matches);
          themeColor?.setAttribute("content", dark ? "#151410" : "#ffffff");
        };
        const showSelection = (theme) => {
          options.forEach((option) => option.setAttribute("aria-pressed", String(option.dataset.themeOption === theme)));
          updateThemeColor(theme);
        };
        const applyTheme = (theme) => {
          if (theme === "system") {
            delete root.dataset.theme;
            try { localStorage.removeItem("preferred-theme"); } catch {}
          } else {
            root.dataset.theme = theme;
            try { localStorage.setItem("preferred-theme", theme); } catch {}
          }
          showSelection(theme);
        };

        showSelection(readTheme());
        options.forEach((option) => option.addEventListener("click", () => {
          applyTheme(option.dataset.themeOption);
          picker.removeAttribute("open");
          pickerSummary?.focus();
        }));
        picker.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            picker.removeAttribute("open");
            pickerSummary?.focus();
          }
        });
        document.addEventListener("click", (event) => {
          if (picker.hasAttribute("open") && !picker.contains(event.target)) picker.removeAttribute("open");
        });
        media.addEventListener?.("change", () => {
          if (readTheme() === "system") updateThemeColor("system");
        });
      })();
    </script>
  </body>
</html>
