---
import { ui } from "../lib/i18n";
import { formatDate, isSelf, type Locale, type Publication } from "../lib/content";

interface Props { item: Publication; locale: Locale; compact?: boolean }
const { item, locale, compact = false } = Astro.props;
const names = item.authors;
const link = item.doi ? `https://doi.org/${item.doi}` : item.url;
const details = [
  item.venue,
  item.volume ? `${locale === "ja" ? "Vol." : "vol."} ${item.volume}${item.issue ? `(${item.issue})` : ""}` : "",
  item.pages ? `pp. ${item.pages}` : "",
].filter(Boolean);
---

<article data-record-id={item.id} class:list={["publication", { compact }]}>
  <p class="publication-date"><time datetime={item.date}>{formatDate(item.date, locale)}</time></p>
  <div>
    <h3 lang={item.fieldLanguages.title}>{link ? <a href={link}>{item.title}</a> : item.title}</h3>
    {!compact && names.length > 0 && (
      <p class="authors" lang={item.fieldLanguages.authors}>
        {names.map((name, index) => (
          <>{isSelf(name) ? <strong>{name}</strong> : name}{index < names.length - 1 ? ", " : ""}</>
        ))}
      </p>
    )}
    {details.length > 0 && <p class="publication-meta"><cite lang={item.fieldLanguages.venue}>{details[0]}</cite>{details.slice(1).map((detail) => ` · ${detail}`)}</p>}
    {item.status === "to-appear" && <p class="publication-meta">{ui[locale].toAppear}</p>}
    {!compact && item.doi && <p class="doi">DOI: <a href={`https://doi.org/${item.doi}`}>{item.doi}</a></p>}
  </div>
</article>
